# Boost as the AROS SDK has it: headers only, no CMake package files. CMake 4 no longer has a FindBoost
# module, so find_package(Boost) needs this file (installed by build-simgear.sh into work/prefix/lib/cmake/Boost).
find_path(Boost_INCLUDE_DIR boost/version.hpp)
if(NOT Boost_INCLUDE_DIR)
    set(Boost_FOUND FALSE)
    return()
endif()
file(STRINGS "${Boost_INCLUDE_DIR}/boost/version.hpp" _boost_version REGEX "#define BOOST_VERSION [0-9]+")
string(REGEX REPLACE ".*BOOST_VERSION ([0-9]+).*" "\\1" Boost_VERSION_MACRO "${_boost_version}")
math(EXPR Boost_VERSION_MAJOR "${Boost_VERSION_MACRO} / 100000")
math(EXPR Boost_VERSION_MINOR "${Boost_VERSION_MACRO} / 100 % 1000")
math(EXPR Boost_VERSION_PATCH "${Boost_VERSION_MACRO} % 100")
set(Boost_VERSION "${Boost_VERSION_MAJOR}.${Boost_VERSION_MINOR}.${Boost_VERSION_PATCH}")
set(Boost_INCLUDE_DIRS "${Boost_INCLUDE_DIR}")
set(Boost_LIBRARIES "")
foreach(_t headers boost)
    if(NOT TARGET Boost::${_t})
        add_library(Boost::${_t} INTERFACE IMPORTED)
        set_target_properties(Boost::${_t} PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${Boost_INCLUDE_DIR}")
    endif()
endforeach()
set(Boost_FOUND TRUE)
