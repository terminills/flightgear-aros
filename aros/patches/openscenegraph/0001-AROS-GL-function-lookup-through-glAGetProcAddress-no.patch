From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Sun, 22 Nov 2026 17:06:45 -0600
Subject: [PATCH 1/3] AROS: GL function lookup through glAGetProcAddress, no
 dlopen, skip the zip plugin
---
 src/osg/GLExtensions.cpp      | 6 ++++++
 src/osgDB/DynamicLibrary.cpp  | 9 +++++++++
 src/osgPlugins/CMakeLists.txt | 2 +-
 3 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/src/osg/GLExtensions.cpp b/src/osg/GLExtensions.cpp
index af9547d..89ef7ed 100644
--- a/src/osg/GLExtensions.cpp
+++ b/src/osg/GLExtensions.cpp
@@ -52,6 +52,8 @@
 #elif defined(__EMSCRIPTEN__)
     // Emscripten ships EGL, which we use to get OpenGL function addresses.
     #include <EGL/egl.h>
+#elif defined(__AROS__)
+    #include <GL/gla.h>
 #else
     #include <dlfcn.h>
 #endif
@@ -340,6 +342,10 @@ OSG_INIT_SINGLETON_PROXY(GLExtensionDisableStringInitializationProxy, osg::getGL
         #endif
         return dlsym(handle, funcName);
 
+    #elif defined(__AROS__)
+
+        return (void*)glAGetProcAddress((const GLubyte*)funcName);
+
     #elif defined(_WIN32)
 
         #if defined(OSG_GLES2_AVAILABLE)
diff --git a/src/osgDB/DynamicLibrary.cpp b/src/osgDB/DynamicLibrary.cpp
index c26cd4a..e3fd337 100644
--- a/src/osgDB/DynamicLibrary.cpp
+++ b/src/osgDB/DynamicLibrary.cpp
@@ -25,6 +25,15 @@
 #include <winbase.h>
 #elif defined(__APPLE__) && defined(APPLE_PRE_10_3)
 #include <mach-o/dyld.h>
+#elif defined(__AROS__)
+// No dlopen() on AROS: plugins are linked statically.
+#include <unistd.h>
+#define RTLD_LAZY 0
+#define RTLD_GLOBAL 0
+static void* dlopen(const char*, int) { return 0; }
+static void* dlsym(void*, const char*) { return 0; }
+static int dlclose(void*) { return 0; }
+static const char* dlerror() { return "dynamic libraries are not supported on AROS"; }
 #else // all other unix
 #include <unistd.h>
 #ifdef __hpux
diff --git a/src/osgPlugins/CMakeLists.txt b/src/osgPlugins/CMakeLists.txt
index 32a78c1..f59666f 100644
--- a/src/osgPlugins/CMakeLists.txt
+++ b/src/osgPlugins/CMakeLists.txt
@@ -264,7 +264,7 @@ ENDIF()
 #     ADD_SUBDIRECTORY(qfont)
 # ENDIF()
 
-IF(ZLIB_FOUND)
+IF(ZLIB_FOUND AND NOT AROS)
     ADD_SUBDIRECTORY(zip)
 ENDIF()
 
