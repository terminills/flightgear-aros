+    { RAWKEY_PAGEDOWN,    GUIEventAdapter::KEY_Page_Down },
+    { RAWKEY_HELP,        GUIEventAdapter::KEY_Help },
+    { RAWKEY_UP,          GUIEventAdapter::KEY_Up },
+    { RAWKEY_DOWN,        GUIEventAdapter::KEY_Down },
+    { RAWKEY_LEFT,        GUIEventAdapter::KEY_Left },
