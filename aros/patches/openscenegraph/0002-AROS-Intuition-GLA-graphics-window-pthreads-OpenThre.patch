+
+int lookupKey(unsigned int raw)
+{
+    for (unsigned int i = 0; i < sizeof(keyTable) / sizeof(keyTable[0]); ++i)
+    {
+        if (keyTable[i].raw == raw) return keyTable[i].key;
+    }
+    return 0;
+}
+
+/* The character the keymap gives for a raw key, or 0 when it is not one character. */
+int mapCharacter(UWORD code, UWORD qualifier, APTR deadKeys)
+{
+    struct InputEvent ie;
+    UBYTE buffer[8];
+
+    memset(&ie, 0, sizeof(ie));
+    ie.ie_Class = IECLASS_RAWKEY;
+    ie.ie_Code = code;
+    ie.ie_Qualifier = qualifier;
+    ie.ie_EventAddress = deadKeys;
+
+    if (MapRawKey(&ie, (STRPTR)buffer, sizeof(buffer), NULL) == 1) return buffer[0];
+    return 0;
+}
+
+unsigned int modKeyMask(UWORD qualifier)
+{
+    unsigned int mask = 0;
+
+    if (qualifier & IEQUALIFIER_LSHIFT)     mask |= GUIEventAdapter::MODKEY_LEFT_SHIFT;
+    if (qualifier & IEQUALIFIER_RSHIFT)     mask |= GUIEventAdapter::MODKEY_RIGHT_SHIFT;
+    if (qualifier & IEQUALIFIER_CONTROL)    mask |= GUIEventAdapter::MODKEY_LEFT_CTRL;
+    if (qualifier & IEQUALIFIER_LALT)       mask |= GUIEventAdapter::MODKEY_LEFT_ALT;
+    if (qualifier & IEQUALIFIER_RALT)       mask |= GUIEventAdapter::MODKEY_RIGHT_ALT;
+    if (qualifier & IEQUALIFIER_LCOMMAND)   mask |= GUIEventAdapter::MODKEY_LEFT_SUPER;
+    if (qualifier & IEQUALIFIER_RCOMMAND)   mask |= GUIEventAdapter::MODKEY_RIGHT_SUPER;
+    if (qualifier & IEQUALIFIER_CAPSLOCK)   mask |= GUIEventAdapter::MODKEY_CAPS_LOCK;
+    /* The keypad of an Amiga keymap always gives digits. */
+    mask |= GUIEventAdapter::MODKEY_NUM_LOCK;
+
+    return mask;
+}
+
+/* An empty sprite, for the window that hides its pointer. */
+UWORD blankPointer[6];
