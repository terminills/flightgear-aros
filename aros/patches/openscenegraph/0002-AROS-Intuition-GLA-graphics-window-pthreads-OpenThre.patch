+    { RAWKEY_KP_0,        GUIEventAdapter::KEY_KP_0 },
+    { RAWKEY_KP_1,        GUIEventAdapter::KEY_KP_1 },
+    { RAWKEY_KP_2,        GUIEventAdapter::KEY_KP_2 },
+    { RAWKEY_KP_3,        GUIEventAdapter::KEY_KP_3 },
+    { RAWKEY_KP_4,        GUIEventAdapter::KEY_KP_4 },
+    { RAWKEY_KP_5,        GUIEventAdapter::KEY_KP_5 },
+    { RAWKEY_KP_6,        GUIEventAdapter::KEY_KP_6 },
+    { RAWKEY_KP_7,        GUIEventAdapter::KEY_KP_7 },
+    { RAWKEY_KP_8,        GUIEventAdapter::KEY_KP_8 },
+    { RAWKEY_KP_9,        GUIEventAdapter::KEY_KP_9 },
+    { RAWKEY_KP_DECIMAL,  GUIEventAdapter::KEY_KP_Decimal },
+    { RAWKEY_KP_PLUS,     GUIEventAdapter::KEY_KP_Add },
