+namespace osgViewer
+{
+
+GraphicsWindowAROS::GraphicsWindowAROS(osg::GraphicsContext::Traits* traits):
+    _valid(false),
+    _realized(false),
+    _window(0),
+    _context(0),
+    _cursor(InheritCursor)
+{
+    _traits = traits;
+
+    if (_traits.valid())
+    {
+        _title = _traits->windowName;
+        if (_traits->sharedContext.valid())
+        {
+            OSG_NOTICE << "GraphicsWindowAROS: contexts cannot share objects, sharedContext is ignored" << std::endl;
+        }
+        _valid = true;
+    }
+
+    if (valid())
+    {
+        setState(new osg::State);
+        getState()->setGraphicsContext(this);
+        getState()->setContextID(osg::GraphicsContext::createNewContextID());
+    }
+}
+
+GraphicsWindowAROS::~GraphicsWindowAROS()
+{
+    close(true);
+}
+
+bool GraphicsWindowAROS::openWindow()
+{
+    struct Screen* screen = LockPubScreen(NULL);
+    if (!screen)
+    {
+        OSG_NOTICE << "GraphicsWindowAROS: no public screen" << std::endl;
+        return false;
+    }
+
+    const bool decorated = _traits->windowDecoration;
+    struct TagItem tags[24];
+    int n = 0;
+
+    #define ADDTAG(tag, value) { tags[n].ti_Tag = (tag); tags[n].ti_Data = (IPTR)(value); ++n; }
+
+    ADDTAG(WA_PubScreen, screen);
+    ADDTAG(WA_Left, _traits->x);
+    ADDTAG(WA_Top, _traits->y);
+    ADDTAG(WA_Activate, TRUE);
+    ADDTAG(WA_RMBTrap, TRUE);
+    ADDTAG(WA_ReportMouse, TRUE);
+    ADDTAG(WA_SimpleRefresh, TRUE);
+    ADDTAG(WA_NoCareRefresh, TRUE);
+    ADDTAG(WA_IDCMP, IDCMP_CLOSEWINDOW | IDCMP_NEWSIZE | IDCMP_CHANGEWINDOW | IDCMP_MOUSEMOVE |
+                     IDCMP_MOUSEBUTTONS | IDCMP_RAWKEY | IDCMP_INACTIVEWINDOW);
+    if (decorated)
+    {
+        ADDTAG(WA_Title, _title.c_str());
+        ADDTAG(WA_InnerWidth, _traits->width);
+        ADDTAG(WA_InnerHeight, _traits->height);
+        ADDTAG(WA_DragBar, TRUE);
+        ADDTAG(WA_DepthGadget, TRUE);
+        ADDTAG(WA_CloseGadget, TRUE);
+        if (_traits->supportsResize)
+        {
+            ADDTAG(WA_SizeGadget, TRUE);
+            ADDTAG(WA_SizeBBottom, TRUE);
+            ADDTAG(WA_MinWidth, 160);
+            ADDTAG(WA_MinHeight, 120);
+            ADDTAG(WA_MaxWidth, ~0);
+            ADDTAG(WA_MaxHeight, ~0);
+        }
+    }
+    else
+    {
+        ADDTAG(WA_Width, _traits->width);
+        ADDTAG(WA_Height, _traits->height);
+        ADDTAG(WA_Borderless, TRUE);
+    }
+    ADDTAG(TAG_DONE, 0);
+
+    _window = OpenWindowTagList(NULL, tags);
+    UnlockPubScreen(NULL, screen);
+
+    if (!_window)
+    {
+        OSG_NOTICE << "GraphicsWindowAROS: cannot open a " << _traits->width << "x" << _traits->height
+                   << " window" << std::endl;
+        return false;
+    }
+
+    n = 0;
+    ADDTAG(GLA_Window, _window);
+    ADDTAG(GLA_Left, _window->BorderLeft);
+    ADDTAG(GLA_Top, _window->BorderTop);
+    ADDTAG(GLA_Right, _window->BorderRight);
+    ADDTAG(GLA_Bottom, _window->BorderBottom);
+    ADDTAG(GLA_DoubleBuf, _traits->doubleBuffer ? GL_TRUE : GL_FALSE);
+    ADDTAG(GLA_RGBMode, GL_TRUE);
+    ADDTAG(GLA_AlphaFlag, _traits->alpha ? GL_TRUE : GL_FALSE);
+    ADDTAG(GLA_NoDepth, _traits->depth ? GL_FALSE : GL_TRUE);
+    ADDTAG(GLA_NoStencil, _traits->stencil ? GL_FALSE : GL_TRUE);
+    ADDTAG(GLA_NoAccum, GL_TRUE);
+    ADDTAG(GLA_SwapInterval, _traits->vsync ? 1 : 0);
+
+    const std::string& version = _traits->glContextVersion;
+    const int major = atoi(version.c_str());
+    if (major >= 3)
+    {
+        const std::string::size_type dot = version.find('.');
+
+        ADDTAG(GLA_ContextMajorVersion, major);
+        ADDTAG(GLA_ContextMinorVersion, dot == std::string::npos ? 0 : atoi(version.c_str() + dot + 1));
+        /* 0x1 is the core profile bit of GLX_ and WGL_CONTEXT_PROFILE_MASK_ARB. */
+        if (_traits->glContextProfileMask & 0x1) ADDTAG(GLA_ContextProfile, GLA_PROFILE_CORE);
+    }
+    ADDTAG(TAG_DONE, 0);
+
+    #undef ADDTAG
+
+    _context = glACreateContext(tags);
+    if (!_context)
+    {
+        OSG_NOTICE << "GraphicsWindowAROS: glACreateContext() failed" << std::endl;
+        CloseWindow(_window);
+        _window = 0;
+        return false;
+    }
+
+    return true;
+}
+
+bool GraphicsWindowAROS::realizeImplementation()
+{
+    if (_realized) return true;
+    if (!_valid) return false;
+
+    if (!openWindow())
+    {
+        _valid = false;
+        return false;
+    }
+
+    _realized = true;
+
+    setCursor(_cursor);
+    syncRectangle(getEventQueue()->getTime());
+    getEventQueue()->syncWindowRectangleWithGraphicsContext();
+
+    return true;
+}
+
+void GraphicsWindowAROS::closeImplementation()
+{
+    if (_context)
+    {
+        glADestroyContext((GLAContext)_context);
+        _context = 0;
+    }
+    if (_window)
+    {
+        CloseWindow(_window);
+        _window = 0;
+    }
+
+    _realized = false;
+    _valid = false;
+}
+
+bool GraphicsWindowAROS::makeCurrentImplementation()
+{
+    if (!_realized || !_context) return false;
+
+    glAMakeCurrent((GLAContext)_context);
+    return true;
+}
+
+bool GraphicsWindowAROS::releaseContextImplementation()
+{
+    if (!_realized) return false;
+
+    glAMakeCurrent(NULL);
+    return true;
+}
+
+void GraphicsWindowAROS::swapBuffersImplementation()
+{
+    if (!_realized || !_context) return;
+
+    /* gl.library looks at the window's size again after each swap. */
+    glASwapBuffers((GLAContext)_context);
+}
+
+/* Tell OSG where the drawing area is: its top left on the screen and its size. */
+void GraphicsWindowAROS::syncRectangle(double time)
+{
+    const int x = _window->LeftEdge + _window->BorderLeft;
+    const int y = _window->TopEdge + _window->BorderTop;
+    const int width = _window->Width - _window->BorderLeft - _window->BorderRight;
+    const int height = _window->Height - _window->BorderTop - _window->BorderBottom;
+
+    if (x != _traits->x || y != _traits->y || width != _traits->width || height != _traits->height)
+    {
+        const bool newSize = width != _traits->width || height != _traits->height;
+
+        resized(x, y, width, height);
+        getEventQueue()->windowResize(x, y, width, height, time);
+        if (newSize) requestRedraw();
+    }
+}
+
+void GraphicsWindowAROS::handleKey(struct ::IntuiMessage* msg, double time)
+{
+    const UWORD raw = msg->Code & ~IECODE_UP_PREFIX;
+    const bool up = (msg->Code & IECODE_UP_PREFIX) != 0;
+
+    if (raw == RAWKEY_NM_WHEEL_UP || raw == RAWKEY_NM_WHEEL_DOWN)
+    {
+        if (!up)
+        {
+            getEventQueue()->mouseScroll(raw == RAWKEY_NM_WHEEL_UP ? GUIEventAdapter::SCROLL_UP
+                                                                   : GUIEventAdapter::SCROLL_DOWN, time);
+        }
+        return;
+    }
+    if (raw == RAWKEY_NM_WHEEL_LEFT || raw == RAWKEY_NM_WHEEL_RIGHT)
+    {
+        if (!up)
+        {
+            getEventQueue()->mouseScroll(raw == RAWKEY_NM_WHEEL_LEFT ? GUIEventAdapter::SCROLL_LEFT
+                                                                     : GUIEventAdapter::SCROLL_RIGHT, time);
+        }
+        return;
+    }
+
+    int key = lookupKey(raw);
+    int unmodified = key;
+
+    if (!key)
+    {
+        const UWORD plain = msg->Qualifier & ~(IEQUALIFIER_LSHIFT | IEQUALIFIER_RSHIFT | IEQUALIFIER_CAPSLOCK |
+                                               IEQUALIFIER_CONTROL | IEQUALIFIER_LALT | IEQUALIFIER_RALT |
+                                               IEQUALIFIER_LCOMMAND | IEQUALIFIER_RCOMMAND);
+
+        key = mapCharacter(raw, msg->Qualifier, msg->IAddress ? *(APTR*)msg->IAddress : NULL);
+        unmodified = mapCharacter(raw, plain, NULL);
+        if (!key) key = unmodified;
+        if (!unmodified) unmodified = key;
+    }
+    if (!key) return;
+
+    if (up) getEventQueue()->keyRelease(key, time, unmodified);
+    else    getEventQueue()->keyPress(key, time, unmodified);
+}
+
+bool GraphicsWindowAROS::checkEvents()
+{
+    if (!_realized || !_window) return false;
+
+    struct IntuiMessage* msg;
+    bool moved = false;
+
+    while (_window && (msg = (struct IntuiMessage*)GetMsg(_window->UserPort)))
+    {
+        struct IntuiMessage copy = *msg;
+        APTR deadKeys = NULL;
+
+        /* The dead-key bytes of a key message live in the message. */
+        if (copy.Class == IDCMP_RAWKEY && copy.IAddress)
+        {
+            deadKeys = *(APTR*)copy.IAddress;
+            copy.IAddress = &deadKeys;
+        }
+        ReplyMsg((struct Message*)msg);
+
+        const double time = getEventQueue()->getTime();
+        const float mx = copy.MouseX - _window->BorderLeft;
+        const float my = copy.MouseY - _window->BorderTop;
+
+        if (copy.Class != IDCMP_INACTIVEWINDOW)
+        {
+            getEventQueue()->getCurrentEventState()->setModKeyMask(modKeyMask(copy.Qualifier));
+        }
+
+        switch (copy.Class)
+        {
+            case IDCMP_CLOSEWINDOW:
+                getEventQueue()->closeWindow(time);
+                break;
+
+            case IDCMP_NEWSIZE:
+            case IDCMP_CHANGEWINDOW:
+                moved = true;
+                break;
+
+            case IDCMP_MOUSEMOVE:
+                getEventQueue()->mouseMotion(mx, my, time);
+                break;
+
+            case IDCMP_MOUSEBUTTONS:
+            {
+                const int code = copy.Code & ~IECODE_UP_PREFIX;
+                const int button = code == IECODE_LBUTTON ? 1 :
+                                   code == IECODE_MBUTTON ? 2 :
+                                   code == IECODE_RBUTTON ? 3 : 0;
+
+                if (!button) break;
+                if (copy.Code & IECODE_UP_PREFIX) getEventQueue()->mouseButtonRelease(mx, my, button, time);
+                else                              getEventQueue()->mouseButtonPress(mx, my, button, time);
+                break;
+            }
+
+            case IDCMP_RAWKEY:
+                handleKey(&copy, time);
+                break;
+
+            case IDCMP_INACTIVEWINDOW:
+                /* Key releases go to the next window from here on. */
+                getEventQueue()->getCurrentEventState()->setModKeyMask(GUIEventAdapter::MODKEY_NUM_LOCK);
+                break;
+        }
+    }
+
+    if (moved && _window) syncRectangle(getEventQueue()->getTime());
+
+    return !(getEventQueue()->empty());
+}
+
+bool GraphicsWindowAROS::setWindowDecorationImplementation(bool flag)
+{
+    /* A window keeps the borders it was opened with. */
+    return !_window || flag == _traits->windowDecoration;
+}
+
+bool GraphicsWindowAROS::setWindowRectangleImplementation(int x, int y, int width, int height)
+{
+    if (!_window) return false;
+
+    ChangeWindowBox(_window, x - _window->BorderLeft, y - _window->BorderTop,
+                    width + _window->BorderLeft + _window->BorderRight,
+                    height + _window->BorderTop + _window->BorderBottom);
+    return true;
+}
+
+void GraphicsWindowAROS::setWindowName(const std::string& name)
+{
+    _title = name;
+    _traits->windowName = name;
+    if (_window && _traits->windowDecoration)
+    {
+        SetWindowTitles(_window, (CONST_STRPTR)_title.c_str(), (CONST_STRPTR)~0);
+    }
+}
+
+void GraphicsWindowAROS::setCursor(MouseCursor cursor)
+{
+    _cursor = cursor;
+    if (!_window || cursor == InheritCursor) return;
+
+    struct TagItem tags[2];
+
+    tags[0].ti_Tag = WA_BusyPointer;
+    tags[0].ti_Data = (cursor == WaitCursor) ? TRUE : FALSE;
+    tags[1].ti_Tag = TAG_DONE;
+    tags[1].ti_Data = 0;
+
+    if (cursor == NoCursor) SetPointer(_window, blankPointer, 1, 1, 0, 0);
+    else if (cursor == WaitCursor) SetWindowPointerA(_window, tags);
+    else ClearPointer(_window);
+}
+
+void GraphicsWindowAROS::grabFocus()
+{
+    if (_window) ActivateWindow(_window);
+}
+
+void GraphicsWindowAROS::grabFocusIfPointerInWindow()
+{
+    if (!_window) return;
+
+    if (_window->MouseX >= 0 && _window->MouseX < _window->Width &&
+        _window->MouseY >= 0 && _window->MouseY < _window->Height)
+    {
+        ActivateWindow(_window);
+    }
+}
+
+void GraphicsWindowAROS::raiseWindow()
+{
+    if (_window) WindowToFront(_window);
+}
+
+void GraphicsWindowAROS::requestWarpPointer(float x, float y)
+{
+    if (!_window) return;
+
+    struct MsgPort* port = CreateMsgPort();
+    if (port)
+    {
+        struct IOStdReq* io = (struct IOStdReq*)CreateIORequest(port, sizeof(struct IOStdReq));
+        if (io)
+        {
+            if (OpenDevice((CONST_STRPTR)"input.device", 0, (struct IORequest*)io, 0) == 0)
+            {
+                struct InputEvent ie;
+                struct IEPointerPixel pixel;
+
+                pixel.iepp_Screen = _window->WScreen;
+                pixel.iepp_Position.X = _window->LeftEdge + _window->BorderLeft + (WORD)x;
+                pixel.iepp_Position.Y = _window->TopEdge + _window->BorderTop + (WORD)y;
+
+                memset(&ie, 0, sizeof(ie));
+                ie.ie_Class = IECLASS_NEWPOINTERPOS;
+                ie.ie_SubClass = IESUBCLASS_PIXEL;
+                ie.ie_Code = IECODE_NOBUTTON;
+                ie.ie_EventAddress = &pixel;
+
+                io->io_Command = IND_WRITEEVENT;
+                io->io_Data = &ie;
+                io->io_Length = sizeof(ie);
+                DoIO((struct IORequest*)io);
+
+                CloseDevice((struct IORequest*)io);
+            }
+            DeleteIORequest((struct IORequest*)io);
+        }
+        DeleteMsgPort(port);
+    }
+
+    getEventQueue()->mouseWarped(x, y);
+}
+
