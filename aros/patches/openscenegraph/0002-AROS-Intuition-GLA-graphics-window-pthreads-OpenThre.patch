+class AROSWindowingSystemInterface : public osg::GraphicsContext::WindowingSystemInterface
+{
+    public:
+
+        AROSWindowingSystemInterface() {}
+
+        virtual unsigned int getNumScreens(const osg::GraphicsContext::ScreenIdentifier& /*si*/)
+        {
+            return 1;
+        }
+
+        virtual void getScreenSettings(const osg::GraphicsContext::ScreenIdentifier& /*si*/,
+                                       osg::GraphicsContext::ScreenSettings& resolution)
+        {
+            resolution = osg::GraphicsContext::ScreenSettings();
+
+            struct Screen* screen = LockPubScreen(NULL);
+            if (screen)
+            {
+                resolution.width = screen->Width;
+                resolution.height = screen->Height;
+                resolution.colorDepth = GetBitMapAttr(screen->RastPort.BitMap, BMA_DEPTH);
+                UnlockPubScreen(NULL, screen);
+            }
+        }
+
+        virtual void enumerateScreenSettings(const osg::GraphicsContext::ScreenIdentifier& si,
+                                             osg::GraphicsContext::ScreenSettingsList& resolutionList)
+        {
+            osg::GraphicsContext::ScreenSettings resolution;
+
+            resolutionList.clear();
+            getScreenSettings(si, resolution);
+            if (resolution.width > 0) resolutionList.push_back(resolution);
+        }
+
+        virtual osg::GraphicsContext* createGraphicsContext(osg::GraphicsContext::Traits* traits)
+        {
+            /* No pbuffers through glA: the caller falls back to an FBO. */
+            if (traits->pbuffer) return 0;
+
+            osg::ref_ptr<osgViewer::GraphicsWindowAROS> window = new osgViewer::GraphicsWindowAROS(traits);
+            if (window->valid()) return window.release();
+            return 0;
+        }
+
+    protected:
+
+        virtual ~AROSWindowingSystemInterface()
+        {
+            if (osg::Referenced::getDeleteHandler())
+            {
+                osg::Referenced::getDeleteHandler()->setNumFramesToRetainObjects(0);
+                osg::Referenced::getDeleteHandler()->flushAll();
+            }
+        }
+};
+
+}
