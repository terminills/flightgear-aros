From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Mon, 23 Nov 2026 23:18:28 -0600
Subject: [PATCH 3/3] AROS: PNG reader leaves a libpng error by longjmp

libpng is the shared png.library on AROS; its frames carry no unwind
information, so the PNGError thrown from the error callback ended in
std::terminate instead of reaching the catch around the read. On AROS
the callback prints the message and uses png_longjmp(); readPNGStream
sets the jump buffer once the info structures exist and frees what it
had allocated.

Seen executing in the guest: 'PNG lib error: IDAT: CRC error', 'Error
reading file ... read error', and the program goes on.
---
 src/osgPlugins/png/ReaderWriterPNG.cpp | 34 ++++++++++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/src/osgPlugins/png/ReaderWriterPNG.cpp b/src/osgPlugins/png/ReaderWriterPNG.cpp
index 6140147..af9e293 100644
--- a/src/osgPlugins/png/ReaderWriterPNG.cpp
+++ b/src/osgPlugins/png/ReaderWriterPNG.cpp
@@ -52,8 +52,21 @@ private:
     std::string _message;
 };
 
+#if defined(__AROS__)
+// libpng is the shared png.library there: an exception does not get through its frames,
+// so the error leaves it the way libpng provides, by longjmp
+#define PNG_ERROR_BY_LONGJMP
+#endif
+
 void user_error_fn(png_structp png_ptr, png_const_charp error_msg)
 {
+#ifdef PNG_ERROR_BY_LONGJMP
+    {
+        const std::string *filename_ptr = static_cast<const std::string*>(png_get_error_ptr(png_ptr));
+        OSG_WARN << PNGError(error_msg, filename_ptr ? *filename_ptr : "unknown") << std::endl;
+    }
+    png_longjmp(png_ptr, 1);
+#else
     const std::string *filename_ptr = static_cast<const std::string*>(png_get_error_ptr(png_ptr));
     std::string filename = filename_ptr ? *filename_ptr : "unknown";
 
@@ -62,6 +75,7 @@ void user_error_fn(png_structp png_ptr, png_const_charp error_msg)
 #else
     OSG_WARN << "PNG lib warning in file " << filename << ": " << error_msg << std::endl;
 #endif
+#endif
 }
 
 void user_warning_fn(png_structp png_ptr, png_const_charp warning_msg)
@@ -198,6 +212,19 @@ class ReaderWriterPNG : public osgDB::ReaderWriter
                 info = png_create_info_struct(png);
                 endinfo = png_create_info_struct(png);
 
+            #ifdef PNG_ERROR_BY_LONGJMP
+                // what is allocated after this point, to be read back after the jump
+                unsigned char* volatile jmpData = NULL;
+                png_bytep* volatile jmpRows = NULL;
+                if (setjmp(png_jmpbuf(png)))
+                {
+                    delete [] jmpRows;
+                    delete [] jmpData;
+                    png_destroy_read_struct(&png, &info, &endinfo);
+                    return ReadResult::ERROR_IN_READING_FILE;
+                }
+            #endif
+
                 fin.read((char*)header,8);
                 if (fin.gcount() == 8 && png_sig_cmp(header, 0, 8) == 0)
                     png_set_read_fn(png,&fin,png_read_istream); //Use custom read function that will get data from istream
@@ -278,6 +305,10 @@ class ReaderWriterPNG : public osgDB::ReaderWriter
 
                 data = (png_bytep) new unsigned char [png_get_rowbytes(png, info)*height];
                 row_p = new png_bytep [height];
+            #ifdef PNG_ERROR_BY_LONGJMP
+                jmpData = data;
+                jmpRows = row_p;
+            #endif
 
                 bool StandardOrientation = true;
                 for (i = 0; i < height; i++)
@@ -290,6 +321,9 @@ class ReaderWriterPNG : public osgDB::ReaderWriter
 
                 png_read_image(png, row_p);
                 delete [] row_p;
+            #ifdef PNG_ERROR_BY_LONGJMP
+                jmpRows = NULL;
+            #endif
                 png_read_end(png, endinfo);
 
                 GLenum pixelFormat = 0;
