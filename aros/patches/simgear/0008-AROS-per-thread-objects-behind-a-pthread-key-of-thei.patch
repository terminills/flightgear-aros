diff --git a/simgear/threads/SGThreadObject.hxx b/simgear/threads/SGThreadObject.hxx
new file mode 100644
index 0000000..d612afa
--- /dev/null
+++ b/simgear/threads/SGThreadObject.hxx
@@ -0,0 +1,40 @@
+// SGThreadObject.hxx - one object per thread, behind a pthread key of its own
+//
+// SPDX-License-Identifier: LGPL-2.0-or-later
+
+#ifndef SG_THREAD_OBJECT_HXX
+#define SG_THREAD_OBJECT_HXX
+
+#include <pthread.h>
+
+/**
+ * One T per thread, made at the thread's first get() and deleted when the thread ends.
+ *
+ * For where a thread_local with a destructor is not safe: with GCC's emulated TLS and
+ * libstdc++'s own list of thread_local destructors, both hang on pthread keys, and a
+ * pthread library that runs key destructors in the order the keys were made frees the
+ * storage before the objects in it are destroyed.
+ */
+template <class T>
+class SGThreadObject
+{
+public:
+    SGThreadObject() { pthread_key_create(&_key, &destroy); }
+
+    T& get()
+    {
+        T* object = static_cast<T*>(pthread_getspecific(_key));
+        if (!object) {
+            object = new T;
+            pthread_setspecific(_key, object);
+        }
+        return *object;
+    }
+
+private:
+    static void destroy(void* object) { delete static_cast<T*>(object); }
+
+    pthread_key_t _key;
+};
+
+#endif // SG_THREAD_OBJECT_HXX
