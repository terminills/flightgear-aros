+#ifndef FG_JS_AROS_HIDD_H
+#define FG_JS_AROS_HIDD_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define FGAROS_JS_MAX_AXES 32
+
+struct fgaros_js {
+    unsigned short id;                      /* the controller's id in controller.hidd */
+    int num_axes;
+    int num_buttons;
+    char name[128];
+    unsigned char src[FGAROS_JS_MAX_AXES];  /* where each axis comes from, see jsAROS_hidd.c */
+};
+
+/* Opens controller.hidd. Returns 0 when the system has none. May be called more than once. */
+int fgaros_js_init(void);
+
+/* Fills *js with the controller of joystick number ident. Returns 0 when there is none. */
+int fgaros_js_open(int ident, struct fgaros_js *js);
+
+/* Reads the buttons (bit n is button n) and the axes (-32767 to 32767). Returns 0 when the controller is gone. */
+int fgaros_js_read(const struct fgaros_js *js, int *buttons, float *axes);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
