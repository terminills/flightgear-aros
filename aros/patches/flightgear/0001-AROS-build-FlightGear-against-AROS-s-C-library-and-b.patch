+++ b/3rdparty/hts_engine_API/lib/HTS_misc.c
@@ -282,7 +282,7 @@ size_t HTS_ftell(HTS_File * fp)
    } else if (fp->type == HTS_FILE) {
       fpos_t pos;
       fgetpos((FILE *) fp->pointer, &pos);
-#if defined(_WIN32) || defined(__CYGWIN__) || defined(__APPLE__) || defined(__FreeBSD__) || defined(__ANDROID__) || defined(__OpenBSD__)
+#if defined(_WIN32) || defined(__CYGWIN__) || defined(__APPLE__) || defined(__FreeBSD__) || defined(__ANDROID__) || defined(__OpenBSD__) || defined(__AROS__)
       return (size_t) pos;
 #else
       return (size_t) pos.__pos;
diff --git a/3rdparty/mongoose/mongoose.c b/3rdparty/mongoose/mongoose.c
index 84c2d60..ffdfe20 100644
--- a/3rdparty/mongoose/mongoose.c
+++ b/3rdparty/mongoose/mongoose.c
@@ -123,7 +123,13 @@ typedef struct _stati64 ns_stat_t;
 #include <netinet/in.h>
 #include <sys/socket.h>
 #include <sys/select.h>
+#ifdef __AROS__
+/* sockets are not file descriptors of the C library, and there is no fork() for CGI */
+#define closesocket(x) fgaros_closesocket(x)
+#define MONGOOSE_NO_CGI
+#else
 #define closesocket(x) close(x)
+#endif
 #define __cdecl
 #define INVALID_SOCKET (-1)
 #define to64(x) strtoll(x, NULL, 10)
@@ -530,6 +536,8 @@ static void ns_close_conn(struct ns_connection *conn) {
 void ns_set_close_on_exec(sock_t sock) {
 #ifdef _WIN32
   (void) SetHandleInformation((HANDLE) sock, HANDLE_FLAG_INHERIT, 0);
+#elif defined(__AROS__)
+  (void) sock;
 #else
   fcntl(sock, F_SETFD, FD_CLOEXEC);
 #endif
@@ -539,6 +547,8 @@ static void ns_set_non_blocking_mode(sock_t sock) {
 #ifdef _WIN32
   unsigned long on = 1;
   ioctlsocket(sock, FIONBIO, &on);
+#elif defined(__AROS__)
+  fgaros_socket_nonblocking(sock, 1);
 #else
   int flags = fcntl(sock, F_GETFL, 0);
   fcntl(sock, F_SETFL, flags | O_NONBLOCK);
@@ -1270,7 +1280,9 @@ typedef HANDLE process_id_t;
 #else                    ////////////// UNIX specific defines and includes
 
 #include <dirent.h>
+#ifndef __AROS__
 #include <dlfcn.h>
+#endif
 #include <inttypes.h>
 #include <pwd.h>
 #define O_BINARY 0
diff --git a/3rdparty/sqlite3/sqlite3.c b/3rdparty/sqlite3/sqlite3.c
index 37b534a..528c780 100644
--- a/3rdparty/sqlite3/sqlite3.c
+++ b/3rdparty/sqlite3/sqlite3.c
@@ -1,3 +1,11 @@
+#ifdef __AROS__
+/* no shared-memory files for a write-ahead log; exec/types.h, which pthread.h
+** brings in, has a GLOBAL of its own and must be read before ours is defined */
+#define SQLITE_OMIT_WAL 1
+#include <exec/types.h>
+#include <pthread.h>
+#undef GLOBAL
+#endif
 /******************************************************************************
 ** This file is an amalgamation of many separate C source files from SQLite
 ** version 3.49.1.  By combining all the individual C code files into this
@@ -39611,7 +39619,7 @@ static struct vxworksFileId *vxworksFindFileId(const char *zAbsoluteName){
   struct vxworksFileId *pCandidate;   /* For looping over existing file IDs */
   int n;                              /* Length of zAbsoluteName string */
 
-  assert( zAbsoluteName[0]=='/' );
+  assert( zAbsoluteName[0]=='/' || strchr(zAbsoluteName, ':') );
   n = (int)strlen(zAbsoluteName);
   pNew = sqlite3_malloc64( sizeof(*pNew) + (n+1) );
   if( pNew==0 ) return 0;
@@ -41908,6 +41916,17 @@ static int seekAndRead(unixFile *id, sqlite3_int64 offset, void *pBuf, int cnt){
     got = osPread64(id->h, pBuf, cnt, offset);
     SimulateIOError( got = -1 );
 #else
+#ifdef __AROS__
+    /* lseek() past the end makes the file longer on AROS; reading the header
+    ** of a new, empty database must not do that */
+    if( offset==24 && cnt==16 ){
+      newOffset = lseek(id->h, 0, SEEK_END);
+      if( newOffset<offset ){
+        got = 0;
+        break;
+      }
+    }
+#endif
     newOffset = lseek(id->h, offset, SEEK_SET);
     SimulateIOError( newOffset = -1 );
     if( newOffset<0 ){
@@ -42308,7 +42327,11 @@ static int openDirectory(const char *zFilename, int *pFd){
   char zDirname[MAX_PATHNAME+1];
 
   sqlite3_snprintf(MAX_PATHNAME, zDirname, "%s", zFilename);
+#ifdef __AROS__
+  for(ii=(int)strlen(zDirname); ii>0 && zDirname[ii]!='/' && zDirname[ii-1]!=':'; ii--);
+#else
   for(ii=(int)strlen(zDirname); ii>0 && zDirname[ii]!='/'; ii--);
+#endif
   if( ii>0 ){
     zDirname[ii] = '\0';
   }else{
@@ -45226,6 +45249,9 @@ static void appendOnePathElement(
     return;
   }
   pPath->zOut[pPath->nUsed++] = '/';
+#ifdef __AROS__
+  if( pPath->nUsed==1 ) pPath->nUsed--;   /* "Volume:dir", not "/Volume:dir" */
+#endif
   memcpy(&pPath->zOut[pPath->nUsed], zName, nName);
   pPath->nUsed += nName;
 #if defined(HAVE_READLINK) && defined(HAVE_LSTAT)
@@ -45302,7 +45328,11 @@ static int unixFullPathname(
   path.nSymlink = 0;
   path.nOut = nOut;
   path.zOut = zOut;
+#ifdef __AROS__
+  if( zPath[0]!='/' && strchr(zPath, ':')==NULL ){
+#else
   if( zPath[0]!='/' ){
+#endif
     char zPwd[SQLITE_MAX_PATHLEN+2];
     if( osGetcwd(zPwd, sizeof(zPwd)-2)==0 ){
       return unixLogError(SQLITE_CANTOPEN_BKPT, "getcwd", zPath);
@@ -45399,7 +45429,9 @@ static int unixRandomness(sqlite3_vfs *NotUsed, int nBuf, char *zBuf){
   */
   memset(zBuf, 0, nBuf);
   randomnessPid = osGetpid(0);
-#if !defined(SQLITE_TEST) && !defined(SQLITE_OMIT_RANDOMNESS)
+#if defined(__AROS__)
+  arc4random_buf(zBuf, nBuf);   /* there is no /dev/urandom to open */
+#elif !defined(SQLITE_TEST) && !defined(SQLITE_OMIT_RANDOMNESS)
   {
     int fd, got;
     fd = robust_open("/dev/urandom", O_RDONLY, 0);
@@ -46783,6 +46815,10 @@ SQLITE_API int sqlite3_os_init(void){
   ** array cannot be const.
   */
   static sqlite3_vfs aVfs[] = {
+#if defined(__AROS__)
+    /* the first entry is the default: no fcntl() record locks on AROS */
+    UNIXVFS("unix-none",     nolockIoFinder ),
+#endif
 #if SQLITE_ENABLE_LOCKING_STYLE && defined(__APPLE__)
     UNIXVFS("unix",          autolockIoFinder ),
 #elif OS_VXWORKS
diff --git a/src/EmbeddedResources/CMakeLists.txt b/src/EmbeddedResources/CMakeLists.txt
index 6f53a5d..aab3f9f 100644
--- a/src/EmbeddedResources/CMakeLists.txt
+++ b/src/EmbeddedResources/CMakeLists.txt
@@ -1,5 +1,11 @@
-add_executable(fgrcc fgrcc.cxx fgrcc.hxx)
-target_link_libraries(fgrcc SimGearCore)
+# A cross build cannot run the fgrcc it builds: FGRCC_EXECUTABLE names one built for the build machine.
+if(CMAKE_CROSSCOMPILING AND FGRCC_EXECUTABLE)
+  add_executable(fgrcc IMPORTED GLOBAL)
+  set_target_properties(fgrcc PROPERTIES IMPORTED_LOCATION "${FGRCC_EXECUTABLE}")
+else()
+  add_executable(fgrcc fgrcc.cxx fgrcc.hxx)
+  target_link_libraries(fgrcc SimGearCore)
+endif()
 
 # On Windows, make sure fgrcc can be run (it needs third-party libraries) in add_custom_target
 if(MSVC)
