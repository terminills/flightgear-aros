     fcntl(sckt, F_SETFL, flags | O_NONBLOCK);
@@ -211,6 +213,8 @@ FGfdmSocket::FGfdmSocket(int port, int protocol, int precision)
 #ifdef _WIN32
           u_long NoBlock = 1;
           ioctlsocket(sckt, FIONBIO, &NoBlock);
+#elif defined(__AROS__)
+          fgaros_socket_nonblocking(sckt, 1);
 #else
           int flags = fcntl(sckt, F_GETFL, 0);
           fcntl(sckt, F_SETFL, flags | O_NONBLOCK);
@@ -255,6 +259,8 @@ string FGfdmSocket::Receive(void)
 #ifdef _WIN32
       u_long NoBlock = 1;
       ioctlsocket(sckt_in, FIONBIO, &NoBlock);
+#elif defined(__AROS__)
+      fgaros_socket_nonblocking(sckt_in, 1);
 #else
       int flags = fcntl(sckt_in, F_GETFL, 0);
       fcntl(sckt_in, F_SETFL, flags | O_NONBLOCK);
@@ -317,6 +323,8 @@ void FGfdmSocket::Close(void)
 {
 #ifdef _WIN32
   closesocket(sckt_in);
+#elif defined(__AROS__)
+  fgaros_closesocket(sckt_in);
 #else
   close(sckt_in);
 #endif
